<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>图书详情 - 图书借阅系统后台管理</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        <h1 class="header">图书详细信息</h1>
        
        <div class="detail-card">
            <table class="detail-table">
                <tr>
                    <th>图书编号：</th>
                    <td><%= book.bookCode %></td>
                </tr>
                <tr>
                    <th>图书名称：</th>
                    <td><%= book.bookName %></td>
                </tr>
                <tr>
                    <th>图书类型：</th>
                    <td><%= book.typeName %></td>
                </tr>
                <tr>
                    <th>作者：</th>
                    <td><%= book.bookAuthor %></td>
                </tr>
                <tr>
                    <th>出版社：</th>
                    <td><%= book.publishPress %></td>
                </tr>
                <tr>
                    <th>出版日期：</th>
                    <td><%= new Date(book.publishDate).toLocaleDateString('zh-CN') %></td>
                </tr>
                <tr>
                    <th>是否借阅：</th>
                    <td><%= book.borrowed === 1 ? '已借阅' : '未借阅' %></td>
                </tr>
                <tr>
                    <th>入库人：</th>
                    <td><%= book.createdBy %></td>
                </tr>
                <tr>
                    <th>入库时间：</th>
                    <td><%= new Date(book.creationTime).toLocaleDateString('zh-CN') %></td>
                </tr>
            </table>
            
            <div class="form-actions">
                <a href="/books" class="btn btn-default">返回</a>
            </div>
        </div>
    </div>
</body>
</html>
